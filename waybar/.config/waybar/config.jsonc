{
   "layer": "bottom",
   "position": "top",
   "margin-top": 10,
   "margin-left": 10,
   "margin-right": 10,
   "margin-bottom": 1,
   "reload_style_on_change": true,

   "modules-left": [
      "hyprland/workspaces",
      "custom/separator",
      "clock"
   ],
   
   "modules-right": [
      "memory",
      "cpu",
      "temperature"
   ],

   "niri/workspaces": {
      "format": "{value}",
      "format-icons": {
      "focused": "󱓻",
      "default": "󱓼"
      }
   },

   "hyprland/workspaces": {
      "format": "{name}/10",
      "active-only": true
   },

   "niri/window": {
      "format": "{title}"
   },

   "hyprland/window": {
      "rewrite": {
         "": "hyprland"
      }
   },

   "custom/arch": {
      "format": "󰣇",
      "tooltip-format": "this is arch btw"
   },
   
   "custom/separator": {
      "format": "-"
   },
   
   "temperature": {
      "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
      "critical-thresold": 82,
      "format": "  {temperatureC}°C",
      "interval": 1
   },

   "cpu": {
      "format": "  {usage}%"
   },

   "memory": {
      "format": "   {}%"
   },

   "network": {
      "format-wifi": " ",
      "format-ethernet": "󰈀",
      "format-linked": "",
      "format-disconnected": "⚠ ",
      "tooltip-format": "{essid}\n{ipaddr}/{cidr}",
      "tooltip": true,
      "on-click": "kitty -e nmtui"
   },

   "clock": {
      "format": "{:%I:%M %p}",
      "format-alt": "{:%A, %d %b, %Y}",
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
         "months": "<span color='#d4be98'><b>{}</b></span>",
         "days": "<span color='#d4be98'><b>{}</b></span>",
         "weeks": "<span color='#a9b665'><b>W{}</b></span>",
         "weekdays": "<span color='#d8a657'><b>{}</b></span>",
         "today": "<span color='#e78a4e'><b><u>{}</u></b></span>"
      }
   },

      "actions": {
      "on-click-middle": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
      }
   },

   "pulseaudio": {
      "scroll-step": 1,
      "format": "{icon}  {volume}%",
      "format-bluetooth": "{volume}% {icon} {format_source}",
      "format-bluetooth-muted": "<span foreground='#ea6962'>  {format_source}</span>",
      "format-muted": "<span foreground='#ea6962'> </span> {format_source}",
      "format-source": " ",
      "format-source-muted": " <span foreground='#ea6962'></span>",
      "format-icons": {
      "headphone": " ",
      "headset": " ",
      "default": [
         "",
         "",
         ""
      ]
   },

      "tooltip": false,
      "on-click": "pavucontrol"
   }, 

   "tray": {
      "icon-size": 20,
      "spacing": 10,
      "show-passive-items": true
   }
}
